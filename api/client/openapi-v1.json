{
  "openapi": "3.1.0",
  "info": {
    "title": "Capability Provenance Mesh API",
    "version": "1.0.0",
    "description": "Versioned admission, provenance, registry, and audit contract."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/healthz": { "get": { "operationId": "health", "responses": { "200": { "description": "Live" } } } },
    "/readyz": { "get": { "operationId": "ready", "responses": { "200": { "description": "Ready" } } } },
    "/api/v1/intakes": {
      "post": {
        "operationId": "createIntake",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IntakeRequest" } } } },
        "responses": { "201": { "description": "Quarantined intake", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Intake" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v1/intakes/{id}": {
      "get": { "operationId": "getIntake", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "Intake", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Intake" } } } }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/intakes/{id}/graph": {
      "get": { "operationId": "getGraph", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "Graph", "content": { "application/json": { "schema": { "type": "object", "required": ["edges"], "properties": { "edges": { "type": "array", "items": { "$ref": "#/components/schemas/CapabilityEdge" } } } } } } } } }
    },
    "/api/v1/intakes/{id}/trials": {
      "post": { "operationId": "startTrial", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "202": { "description": "Trial", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Trial" } } } }, "403": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/trials/{id}": {
      "get": { "operationId": "getTrial", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "Trial", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Trial" } } } } } }
    },
    "/api/v1/intakes/{id}/admissions": {
      "post": { "operationId": "decideAdmission", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }, { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdmissionRequest" } } } }, "responses": { "201": { "description": "Decision", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Admission" } } } }, "403": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/registry": {
      "get": { "operationId": "listRegistry", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Registry", "content": { "application/json": { "schema": { "type": "object", "required": ["entries"], "properties": { "entries": { "type": "array", "items": { "$ref": "#/components/schemas/RegistryEntry" } } } } } } } } }
    },
    "/api/v1/registry/{plugin}/{version}": {
      "get": { "operationId": "getRegistryEntry", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "plugin", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "version", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Durable admission", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Admission" } } } }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/audit/{correlation_id}": {
      "get": { "operationId": "getAudit", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "correlation_id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Audit", "content": { "application/json": { "schema": { "type": "object", "required": ["events"], "properties": { "events": { "type": "array", "items": { "$ref": "#/components/schemas/AuditEvent" } } } } } } } } }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "parameters": { "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } },
    "responses": { "Error": { "description": "Typed error envelope", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } } },
    "schemas": {
      "IntakeRequest": { "type": "object", "required": ["plugin_name", "version", "manifest", "scenario_pack"], "properties": { "plugin_name": { "type": "string" }, "version": { "type": "string" }, "manifest": { "type": "string" }, "scenario_pack": { "type": "string" } } },
      "Intake": { "type": "object", "required": ["id", "plugin_name", "version", "state", "manifest_revision", "correlation_id"], "properties": { "id": { "type": "string" }, "plugin_name": { "type": "string" }, "version": { "type": "string" }, "state": { "enum": ["quarantined", "trial-ready", "decided"] }, "manifest_revision": { "type": "integer" }, "correlation_id": { "type": "string" } } },
      "CapabilityEdge": { "type": "object", "required": ["id", "from", "to", "kind", "evidence"], "properties": { "id": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" }, "kind": { "enum": ["declared", "observed", "inferred", "forbidden"] }, "evidence": { "type": "string" } } },
      "Trial": { "type": "object", "required": ["id", "intake_id", "state", "useful_work_score", "risk_score", "effect_count", "graph", "upstreams"], "properties": { "id": { "type": "string" }, "intake_id": { "type": "string" }, "state": { "enum": ["queued", "running", "completed", "failed", "cancelled"] }, "useful_work_score": { "type": "number" }, "risk_score": { "type": "number" }, "effect_count": { "type": "integer" }, "graph": { "type": "array", "items": { "$ref": "#/components/schemas/CapabilityEdge" } }, "upstreams": { "type": "array", "items": { "$ref": "#/components/schemas/UpstreamEvidence" } } } },
      "UpstreamEvidence": { "type": "object", "required": ["project", "revision", "responsibility", "status"], "properties": { "project": { "type": "string" }, "revision": { "type": "string" }, "responsibility": { "type": "string" }, "status": { "enum": ["verified", "failed"] } } },
      "AdmissionRequest": { "type": "object", "required": ["decision", "rationale", "trial_id"], "properties": { "decision": { "enum": ["admitted", "denied"] }, "rationale": { "type": "string" }, "trial_id": { "type": "string" } } },
      "Admission": { "type": "object", "required": ["id", "intake_id", "plugin_name", "version", "decision", "correlation_id", "receipt_digest", "current_pointer_written", "created_at", "trial"], "properties": { "id": { "type": "string" }, "intake_id": { "type": "string" }, "plugin_name": { "type": "string" }, "version": { "type": "string" }, "decision": { "enum": ["admitted", "denied"] }, "correlation_id": { "type": "string" }, "receipt_digest": { "type": "string" }, "current_pointer_written": { "type": "boolean" }, "created_at": { "type": "string" }, "trial": { "$ref": "#/components/schemas/Trial" } } },
      "RegistryEntry": { "type": "object", "required": ["plugin_name", "version", "admission_id", "correlation_id", "receipt_digest", "active", "created_at"], "properties": { "plugin_name": { "type": "string" }, "version": { "type": "string" }, "admission_id": { "type": "string" }, "correlation_id": { "type": "string" }, "receipt_digest": { "type": "string" }, "active": { "type": "boolean" }, "created_at": { "type": "string" } } },
      "AuditEvent": { "type": "object", "required": ["sequence", "kind", "subject", "correlation_id", "occurred_at", "detail"], "properties": { "sequence": { "type": "integer" }, "kind": { "type": "string" }, "subject": { "type": "string" }, "correlation_id": { "type": "string" }, "occurred_at": { "type": "string" }, "detail": { "type": "string" } } },
      "ErrorEnvelope": { "type": "object", "required": ["code", "message", "correlation_id"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "correlation_id": { "type": "string" }, "details": { "type": "object", "additionalProperties": { "type": "string" } } } }
    }
  }
}
