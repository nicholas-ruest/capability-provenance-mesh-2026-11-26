CPM_API_HOST=127.0.0.1
CPM_API_PORT=8080
CPM_FRONTEND_HOST=127.0.0.1
CPM_FRONTEND_PORT=4173
CPM_PUBLIC_API_URL=http://127.0.0.1:8080
CPM_RUN_DIR=${XDG_RUNTIME_DIR:-/tmp}/capability-provenance-mesh-${UID}
CPM_DATA_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/capability-provenance-mesh/data
CPM_TEMP_DIR=${XDG_RUNTIME_DIR:-/tmp}/capability-provenance-mesh-${UID}/tmp
CPM_AUTH_ISSUER=capability-provenance-local
CPM_AUTH_AUDIENCE=capability-provenance-api
CPM_DEMO_TOKEN=local-operator
CPM_REQUEST_TIMEOUT_MS=15000
RUST_LOG=info,cpm_service=debug
