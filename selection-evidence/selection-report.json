  "product": {
    "users": "Platform security and AI infrastructure teams admitting, denying, repairing, and replaying third-party agent capabilities.",
    "capability": "Evidence-closed adaptive capability admission and replay that scans bundles, evaluates authority and reversibility, quarantines effects, signs admitted artifacts, and preserves durable audit retrieval.",
    "bounded_contexts": [
      "Capability Intake and Provenance",
      "Adaptive Admission Policy",
      "Quarantine and Replay",
      "Attestation and Audit"
    ],
    "topology": {
      "frontend": "Responsive React/TypeScript admission workbench with intake, evidence graph, repair, replay, and audit views.",
      "backend": "Versioned Rust API and composition root spanning admission, graph, quarantine, provenance, attestation, persistence, benchmark, and replay.",
      "middleware": "Ordered authn, authz, policy, validation, error, correlation, timeout, and observability controls denying before effects.",
      "persistence": "Durable shared-storage decisions, audit, receipts, and replay surviving refresh and restart."
    },
    "workflows": [
      {
        "name": "primary",
        "user_outcome": "Submit a benign bundle, scan and graph evidence, quarantine it, sign the admitted artifact, and render its receipt."
      },
      {
        "name": "denial-recovery",
        "user_outcome": "Deny authority expansion with zero dispatch/parent mutation, repair the manifest, and admit the corrected bundle."
      },
      {
        "name": "durable-retrieval",
        "user_outcome": "Retrieve the saved decision, provenance, and audit after browser refresh and backend restart."
      }
    ]
  },
